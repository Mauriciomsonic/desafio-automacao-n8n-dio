# =============================================================================
# Variáveis de Ambiente - Assistente de Investimentos RPA + N8N
# Copie este arquivo para .env e preencha com suas configurações reais
# =============================================================================

# URL da página de clientes (GitHub Pages ou servidor local)
URL_CLIENTES=https://<seu-usuario>.github.io/dio-lab-assistente-investimentos-rpa-n8n/

# URL do CSV de produtos de investimento (GitHub Pages ou servidor local)
URL_CSV=https://<seu-usuario>.github.io/dio-lab-assistente-investimentos-rpa-n8n/data.csv

# URL do Webhook do N8N (deixe vazio ou placeholder para modo demonstração)
WEBHOOK_N8N=https://<seu-n8n>.n8n.cloud/webhook/assistente-investimentos

# Configurações de Conexão e Resiliência
TIMEOUT_HTTP=15
MAX_RETRIES=3
LOG_LEVEL=INFO
